# Firebase project -> Project settings -> General -> Your apps -> SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base URL players are sent to (join link / QR). Defaults to the
# main screen's own origin. Set this in dev to your LAN/tunnel URL so phones
# can reach it, e.g. https://abc123.ngrok.app
VITE_PUBLIC_URL=
