{
  "rules": {
    "sessions": {
      "$code": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",

        "hostUid": {
          ".write": "auth != null && data.exists() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": { ".validate": "newData.val() === now" },

        "controllerUid": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString()"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" }
          }
        },

        "games": {
          "beforeAfter": {
            "media": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || !(data.child('before').exists() && data.child('after').exists()) || root.child('sessions').child($code).child('games').child('beforeAfter').child('unlocked').child($uid).val() === true)) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
              }
            },
            "unlocked": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
                ".validate": "newData.val() === true"
              }
            },
            "$other": { ".validate": false }
          },
          "photos": {
            "media": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || !data.child('photo').exists() || root.child('sessions').child($code).child('games').child('photos').child('unlocked').child($uid).val() === true)) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
              }
            },
            "unlocked": {
              "$uid": {
                ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
                ".validate": "newData.val() === true"
              }
            },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "game": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          ".validate": "newData.val() === 'beforeAfter' || newData.val() === 'photos'"
        },

        "jukebox": {
          "tracks": {
            ".write": "auth != null && root.child('sessions').child($code).child('hostUid').val() === auth.uid"
          },
          "durations": {
            ".write": "auth != null && root.child('sessions').child($code).child('hostUid').val() === auth.uid"
          },
          "state": {
            ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
          }
        },

        "hideBlurbs": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          ".validate": "newData.isBoolean()"
        },

        "showDownload": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)",
          ".validate": "newData.isBoolean()"
        },

        "display": {
          ".write": "auth != null && (root.child('sessions').child($code).child('hostUid').val() === auth.uid || root.child('sessions').child($code).child('controllerUid').val() === auth.uid)"
        },

        "$other": { ".validate": false }
      }
    }
  }
}
