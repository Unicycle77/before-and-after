rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files are uploaded by each player under their own uid. Names carry a
    // timestamp (before-123, after-123, video-123, photo-123) so a re-take never serves
    // a stale cached copy.
    match /sessions/{code}/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && (
          (file.matches('(before|after|photo)-[0-9]+')
            && request.resource.contentType.matches('image/.*')
            && request.resource.size < 15 * 1024 * 1024)
          ||
          (file.matches('video-[0-9]+')
            && request.resource.contentType.matches('video/.*')
            && request.resource.size < 300 * 1024 * 1024)
        );
    }
  }
}
